# ============================================================
# Kirim ilovasi — yangi do'kon (mijoz) o'rnatmasi uchun namuna
# Nusxa oling: .env  va qiymatlarni to'ldiring
# ============================================================

# Do'kon nomi (interfeys va Telegram xabarlarida)
COMPANY_NAME=DO'KON NOMI

# MoySklad API tokeni (Настройки → Токены). Ilova va bot faqat shu token orqali ishlaydi
MOYSKLAD_TOKEN=

# Google Gemini (nakladnoy rasmini o'qish uchun)
GEMINI_API_KEY=

# Telegram bildirishnomalari (bo'sh bo'lsa yuborilmaydi)
TELEGRAM_BOT_TOKEN=
SUPER_ADMIN_IDS=
MANAGER_IDS=

# Kirish — MoySklad login/paroli bilan. MoySklad'dagi owner/admin roli avtomatik administrator.
# Qo'shimcha administratorlar (MoySklad loginlari, vergul bilan):
ADMIN_LOGINS=
# Sessiya imzosi uchun maxfiy kalit (bo'sh bo'lsa avtomatik yaratiladi va bazada saqlanadi)
SESSION_SECRET=
SESSION_HOURS=12
# HTTPS (nginx + SSL) orqali ishlaganda true
COOKIE_SECURE=false

# Gateway (/api/gateway/*) — bot kabi ichki xizmatlar. Localhost'dan tokensiz, tashqaridan faqat shu token bilan
GATEWAY_TOKEN=

DATABASE_URL=sqlite:///./kirim.db
APP_HOST=127.0.0.1
APP_PORT=8001
TIMEZONE=Asia/Tashkent
